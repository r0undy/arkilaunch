# Copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase) ---
# Supavisor pooler for both (db.<ref> needs the IPv4 add-on). DIRECT = session 5432 (prepared
# statements), POOLED = transaction 6543. Pooler username is `<role>.<project-ref>`.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The app connects as app_authenticated, never postgres (superusers bypass RLS).
# Generate this; `pnpm db:migrate` sets the role's password from it.
APP_AUTHENTICATED_PASSWORD=
DATABASE_URL_POOLED=postgresql://app_authenticated.<project-ref>:<same-password-as-above>@aws-0-<region>.pooler.supabase.com:6543/postgres
# service_role: migrations + trusted cron only. Never on a request path (RFC-1 / AGENTS.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Identity (RFC-1) ---
# RS256 keypair, PEM, single line with \n escapes (or point to files in deployment).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Seconds, not "10m": a duration string parses as NaN and silently falls back to 600.
JWT_ACCESS_TOKEN_TTL=600

# --- OCR / IDP (Azure AI Document Intelligence) ---
# Terraform-managed; local values:
#   cd infra/terraform/environments/dev && terraform output -raw azure_di_endpoint
#   az cognitiveservices account keys list -n di-arkilaunch-dev -g rg-arkilaunch-dev --query key1 -o tsv
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
# Set to 2 only against an F0 resource (analyzes 2 pages); unset for S0.
AZURE_DI_MAX_PAGES=

# --- Payments (PayMongo) — ArkiLaunch's PARENT account keys ---
# sk_test_... = test mode, sk_live_... = live. ENABLE_PAYMENTS=true without both = boot error.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
ORS_API_KEY=

# --- Cloudflare Turnstile ---
# TURNSTILE_ENABLED=true without the secret = boot error. Blank site key = no widget.
# Test keys: site 1x00000000000000000000AA; secret 1x0000000000000000000000000000000AA passes,
# 2x0000000000000000000000000000000AA fails.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Weather (Open-Meteo free tier, keyless) ---
# 48 calls/site/day against the free tier's 10k/day cap.
WEATHER_POLL_MAX_SITES=200

# --- Feature flags (default off) ---
# OCR flags on without a real Azure DI adapter fail API boot on purpose.
ENABLE_OCR_PIPELINE=false
ENABLE_OCR_KYC=false
# RFC-2 accuracy gate: model-read deductions are refused unless measured >= 90.06% over >= 200
# samples. Set only from a real harness run; setting it without one defeats the gate.
OCR_MEASURED_ACCURACY=
OCR_MEASURED_SAMPLES=
# Gates the weather job and the customer forecast (503 flag_disabled when false).
ENABLE_WEATHER_POLL=false
ENABLE_DIESEL_SCRAPE=false
ENABLE_PAYMENTS=false
# Seed accounts default to password "admin"; a non-local DB needs SEED_PASSWORD (12+ chars) or the override.
# SEED_PASSWORD=
# ALLOW_WEAK_SEED_CREDENTIALS=false
# Staging dir for `pnpm ocr:fixtures:pull` (default .ocr-fixtures). Real scans must never land in the repo.
# OCR_FIXTURES_DIR=

# --- API ---
API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- Platform / tenant hosts ---
# Widens CORS to https://{slug}.<domain> in deployed envs; dev needs nothing.
PLATFORM_DOMAIN=

# --- Email (Resend) ---
# Unset = the API logs emails instead. EMAIL_FROM must be on a Resend-verified domain.
RESEND_API_KEY=
EMAIL_FROM=ArkiLaunch <no-reply@arkilaunch.app>
EMAIL_REPLY_TO=

# --- Web Push ---
# Generate once with `npx web-push generate-vapid-keys`. Unset = push is logged, not sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@arkilaunch.app

# --- Supabase Storage (REST API, server-side only) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET_EDTR=edtr-documents
SUPABASE_STORAGE_BUCKET_KYC=kyc-documents
# Public-read (EDTR/KYC buckets are private, signed-read). Buckets are created by hand in the
# Supabase dashboard; a missing one fails uploads with storage_upload_failed.
SUPABASE_STORAGE_BUCKET_EQUIPMENT=equipment-photos

# --- Web (apps/web, via import.meta.env) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Observability (Azure Monitor) ---
# Optional; blank = instrumentation no-ops.
APPLICATIONINSIGHTS_CONNECTION_STRING=
