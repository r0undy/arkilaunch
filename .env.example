# Copy to .env and fill in real values. Never commit .env (see .gitignore).
# See AGENTS.md "Always: Keep secrets in env only" and BUILD §3.

# --- Database (Supabase) ---
# Verified against a real project: `db.<ref>.supabase.co` does not resolve
# for projects without the IPv4 add-on. Use the Supavisor pooler
# (aws-0-<region>.pooler.supabase.com) for BOTH connections instead:
# Session mode (5432) for DIRECT (migrations need prepared-statement
# support), Transaction mode (6543) for POOLED (the running API/jobs).
# Username on the pooler is `<role>.<project-ref>`, e.g. `postgres.abcdefgh`.
DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The running app authenticates as app_authenticated, never as the
# postgres superuser -- a superuser always bypasses RLS regardless of
# FORCE. `pnpm db:migrate` sets/rotates this role's password from
# APP_AUTHENTICATED_PASSWORD (generate one; it is not a Supabase-issued value).
APP_AUTHENTICATED_PASSWORD=
DATABASE_URL_POOLED=postgresql://app_authenticated.<project-ref>:<same-password-as-above>@aws-0-<region>.pooler.supabase.com:6543/postgres
# service_role: migrations + trusted cron only. Never on a request path (RFC-1 / AGENTS.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Identity (RFC-1) ---
# RS256 keypair, PEM, single line with \n escapes (or point to files in deployment).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Seconds, not a duration string -- auth.service.ts reads
# `Number(process.env.JWT_ACCESS_TOKEN_TTL) || 600`, so "10m" would parse as
# NaN and silently fall back to the 600s default.
JWT_ACCESS_TOKEN_TTL=600

# --- OCR / IDP (Azure AI Document Intelligence) — stubbed until keys arrive (RFC-2) ---
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Payments (PayMongo) — stubbed until keys arrive ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_SUCCESS_URL=
PAYMONGO_CANCEL_URL=

# --- Weather (Open-Meteo commercial plan) — stubbed until keys arrive ---
OPEN_METEO_API_KEY=

# --- Feature flags (RFC-2 §7; default off) ---
# Turning either OCR flag on while no real Azure DI adapter is configured
# makes the API fail to BOOT, deliberately: a process that accepts paper
# uploads it cannot extract from would either fabricate or silently queue
# forever. With them off, a photographed EDTR must be captured together
# with the hours a human read off it (cr-arkilaunch-pilot-honesty.md §2.1).
ENABLE_OCR_PIPELINE=false
ENABLE_OCR_KYC=false
# Gates jobs/src/weather-poll.ts. Was previously absent from this file and
# from Terraform even though it is load-bearing, so the weather job ran on
# cron in every environment and silently no-opped with nothing to explain why.
ENABLE_WEATHER_POLL=false
ENABLE_DIESEL_SCRAPE=false
ENABLE_PAYMENTS=false
# ENABLE_QUOTE_ENGINE was removed: the RFC-3 quotation engine shipped
# unflagged and is in use, so the flag guarded nothing.

# --- API ---
API_PORT=3000
NODE_ENV=development
# Origin allowed to call this API cross-origin (apps/web's Vite dev server).
WEB_ORIGIN=http://localhost:5173

# --- Public catalog (backend-unblock-frontend plan workstream 2) ---
# The storefront (/, /equipment) is anchor-tenant-only for now; a real
# multi-tenant public catalog needs slug resolution, a guest-identity model,
# and a CLR review (deferred, see the Change Record).
ANCHOR_TENANT_SLUG=

# --- Supabase Storage (backend-unblock-frontend plan workstream 4) ---
# Server-side only; distinct from the DATABASE_URL_* Postgres connections
# above -- this is the Storage REST API, not a database role.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET_EDTR=edtr-documents
SUPABASE_STORAGE_BUCKET_KYC=kyc-documents

# --- Web (apps/web, read via import.meta.env; previously undocumented) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
