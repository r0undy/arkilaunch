# Copy to .env (gitignored) for local dev. Read via import.meta.env (Vite).
# See docs/runbook-local-dev.md and the root .env.example's WEB_ORIGIN entry
# (must match this app's dev-server origin for the API's CORS allowlist).

# Base URL of the API, including the /api/v1 prefix (health is NOT under this
# prefix -- GET /health is served at the bare origin).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Public site origin used by scripts/prerender.mjs for canonical/OG URLs and
# by public/robots.txt + public/sitemap.xml. Set to the deployed Vercel
# domain until a real production domain exists.
VITE_PUBLIC_SITE_URL=http://localhost:5173
