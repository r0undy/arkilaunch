# Copy this file to secrets.auto.tfvars (gitignored, auto-loaded by Terraform)
# and fill in real values. NEVER commit secrets.auto.tfvars or paste its
# contents into chat/logs -- these are live credentials.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# See docs/runbook-local-dev.md for what each of these is and where it comes
# from (Supabase project settings, generated RS256 keypair, etc).

database_url_direct         = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
database_url_pooled         = "postgresql://app_authenticated.<project-ref>:<same-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
app_authenticated_password  = "<generate-a-strong-password>"
supabase_service_role_key   = "<from Supabase project settings -> API>"

# RS256 keypair, PEM, single line with \n escapes. Generate with:
#   openssl genrsa -out key.pem 2048 && openssl rsa -in key.pem -pubout -out pub.pem
jwt_private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
jwt_public_key  = "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Leave blank (matches variables.tf defaults) until real vendor keys exist --
# ENABLE_OCR_PIPELINE / ENABLE_PAYMENTS stay false either way.
# azure_di_endpoint       = ""
# azure_di_key            = ""
# paymongo_secret_key     = ""
# paymongo_webhook_secret = ""
