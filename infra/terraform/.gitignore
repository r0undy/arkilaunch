# Local provider plugins/state cache -- never commit, regenerated by `terraform init`.
**/.terraform/
.terraform.lock.hcl.bak

# State itself lives in the remote azurerm backend (see bootstrap/), never locally.
*.tfstate
*.tfstate.*

# Plan files, may contain sensitive values in plaintext.
*.tfplan

# Real secret values for local runs, never committed (template: secrets.auto.tfvars.example).
secrets.auto.tfvars
*.auto.tfvars
!*.auto.tfvars.example
